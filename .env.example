# Copy to .env and adjust. .env is gitignored and must never be committed.
POSTGRES_USER=warden
POSTGRES_PASSWORD=warden_dev_password_change_me
POSTGRES_DB=warden
DATABASE_URL=postgresql+asyncpg://warden:warden_dev_password_change_me@localhost:5432/warden
REDIS_URL=redis://localhost:6379/0

# Gateway
WARDEN_HOST=127.0.0.1
WARDEN_PORT=8080
WARDEN_RESOURCE_URL=http://localhost:8080/mcp
LOG_LEVEL=INFO
CONFIG_DIR=./config

# JWT (ES256 only). Keys are created by `warden keys init-jwt` into ./keys (gitignored).
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=http://localhost:8080/mcp
JWT_KEY_DIR=./keys
JWT_DEFAULT_TTL_SECONDS=900

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_ENABLED=false

# Scanning
CLASSIFIER_ENABLED=false
CLASSIFIER_MODEL=protectai/deberta-v3-base-prompt-injection-v2

# Upstream server settings
NOTES_DB_PATH=./data/notes.sqlite3
FILES_SANDBOX_ROOT=./sandbox
